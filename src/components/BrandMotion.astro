<span class="motion-stage" aria-hidden="true"><span class="motion-word" data-motion><span data-letters>nothing</span><span class="caret"></span></span></span>
<script>
  const word = document.querySelector<HTMLElement>('[data-motion]');
  const letters = word?.querySelector<HTMLElement>('[data-letters]');
  const caret = word?.querySelector<HTMLElement>('.caret');
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const timers: ReturnType<typeof setTimeout>[] = [];
  const positionCaret = () => {
    if (letters && caret) caret.style.transform = `translateX(${letters.getBoundingClientRect().width + 5}px)`;
  };
  const reset = () => {
    timers.splice(0).forEach(clearTimeout);
    word?.classList.remove('playing');
    if (letters) letters.textContent = 'nothing';
    positionCaret();
  };
  if (word && letters && !preference.matches) {
    letters.innerHTML = 'no<span class="t-one">t</span><span class="t-two">t</span>h';
    positionCaret();
    word.classList.add('playing');
    const frames: [number, string][] = [[1200, 'nott'], [1320, 'not'], [1820, 'noth'], [1960, 'nothi'], [2100, 'nothin'], [2240, 'nothing']];
    frames.forEach(([delay, value]) => timers.push(setTimeout(() => { letters.textContent = value; positionCaret(); }, delay)));
    timers.push(setTimeout(() => word.classList.remove('playing'), 4040));
  }
  document.fonts.ready.then(positionCaret);
  window.addEventListener('resize', positionCaret);
  preference.addEventListener('change', reset);
</script>
