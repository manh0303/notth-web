---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
const canonical = new URL(import.meta.env.BASE_URL, Astro.site);
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>NOTTH — Nothing unnecessary.</title><meta name="description" content="Reusable agent workflows for software development. From requirements to review, NOTTH brings project context, decisions and evidence to your AI coding tool." /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#09090d" /><meta property="og:title" content="NOTTH — Nothing unnecessary." /><meta property="og:description" content="A clearer path from requirements to review. Reusable workflows for your AI coding tool." /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} /></head><body><a class="skip-link" href="#main">Skip to content</a><slot /></body></html>
