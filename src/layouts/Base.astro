---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
const canonical = new URL(import.meta.env.BASE_URL, Astro.site);
const socialImage = new URL(`${import.meta.env.BASE_URL}social-card.png`, Astro.site);
const description = 'A clearer workflow for your AI coding tool. NOTTH guides software development from requirements to design, code, test and review.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NOTTH — Nothing unnecessary.</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#09090d" />
    <meta property="og:title" content="NOTTH — Nothing unnecessary." />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NOTTH — Nothing unnecessary. Requirements, Design, Code, Test, Review." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="NOTTH — Nothing unnecessary." />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
